{
  "version": 1,
  "default_key_fields": ["instance_id", "step_t"],
  "notes": [
    "This manifest records the slice policies used by code/scripts/reproduce_paper.py.",
    "Several released diagnostic files contain duplicate instance_id/step_t rows because they include repeated protocol probes. The manifest therefore makes duplicate handling explicit.",
    "For new analyses, prefer keys that include seed when comparing multi-seed files. The paper-facing policies below reproduce the manuscript's reported rounded values from the released artifacts."
  ],
  "groups": {
    "toolsandbox_qwen_table_last": {
      "paths": [
        "data/toolsandbox/qwen-receiver-only.jsonl",
        "data/toolsandbox/qwen-single-full.jsonl",
        "data/toolsandbox/qwen-ma-9B-from-80B.jsonl"
      ],
      "dedupe": "last"
    },
    "toolsandbox_qwen_table_first_with_match": {
      "paths": [
        "data/toolsandbox/qwen-receiver-only.jsonl",
        "data/toolsandbox/qwen-single-full.jsonl",
        "data/toolsandbox/qwen-ma-9B-from-80B.jsonl",
        "data/toolsandbox/qwen-ma-9B-from-9B.jsonl"
      ],
      "dedupe": "first"
    }
  },
  "main_table_qwen": [
    {
      "benchmark": "ContextBench",
      "protocol": "RO",
      "path": "data/contextbench/qwen-receiver-only.jsonl",
      "selector": {},
      "expected_hj": 0.6333333333333333
    },
    {
      "benchmark": "ContextBench",
      "protocol": "SF",
      "path": "data/contextbench/qwen-single-full.jsonl",
      "selector": {},
      "expected_hj": 0.29375
